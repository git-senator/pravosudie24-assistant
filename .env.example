# Образец файла с доступами.
# Скопировать в .env и заполнить своими значениями.
# ВНИМАНИЕ: сам .env в репозиторий не попадает (см. .gitignore).

# --- Аккаунт СЛУШАТЕЛЯ (@RiDiK_51) — читает чаты ---
LISTENER_API_ID=
LISTENER_API_HASH=
LISTENER_PHONE=

# --- Аккаунт АССИСТЕНТА (@Asic_RF) — пишет клиентам ---
ASSISTANT_API_ID=
ASSISTANT_API_HASH=
ASSISTANT_PHONE=

# --- ПОЧТОВЫЙ ЯЩИК — принимает карточки готовых клиентов ---
# Ключи API здесь НЕ нужны: этот аккаунт только получает сообщения,
# а отправляет их Ассистент, который уже вошёл.
# Нужен только адрес получателя.
INBOX_USERNAME=
INBOX_ID=

# --- Мозг ассистента ---
# Рабочий выбор: Claude Haiku 4.5. При двадцати разговорах в день выходит
# около 19 долларов в месяц вместе с отбором лидов.
#
# Другие варианты:
#   claude-opus-5      — умнее всех, около 65 $/мес при том же объёме
#   gemini-3.6-flash   — Google, дешевле, но разговаривает суше
#   заглушка           — ничего никуда не шлёт, для отладки
#
# ВНИМАНИЕ про бесплатный тариф Google: он даёт всего 20 запросов в сутки
# на каждую модель. Один разговор съедает 5-8 запросов, то есть бесплатно
# выходит 2-3 диалога в день. Посмотреть — да, работать — нет.
MODEL=claude-haiku-4-5

# Модель для отбора лидов. Пусто = та же, что и для разговоров, и так лучше:
# на модели попроще категория выходит размытой («другое» вместо «ДТП»),
# а из неё ассистент строит своё первое сообщение человеку.
MODEL_TRIAGE=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Режим ---
# 1 = репетиция: всё работает, но наружу ничего не уходит
DRY_RUN=1

# --- Лимиты отправки (можно только понижать) ---
FIRST_PER_HOUR=3
FIRST_PER_DAY=15
PAUSE_MIN_SEC=480
PAUSE_MAX_SEC=1200
QUIET_FROM=22
QUIET_TO=9
TIMEZONE=Europe/Moscow

# --- Ограничители ---
MAX_MESSAGES_PER_CLIENT=25
DAILY_SPEND_LIMIT=5
FRESHNESS_HOURS=24

# --- Присмотр за диалогами ---
# Как часто проверять, не остался ли кто-то без ответа (секунды)
CATCHUP_SECONDS=90
# Через сколько минут молчания звать юриста на помощь
ALERT_AFTER_MINUTES=20
# Во сколько присылать итоги за сутки. -1 = не присылать
REPORT_HOUR=20

# --- Белый список чатов ---
# Если заполнить — слушаем ТОЛЬКО эти чаты, остальные не трогаем.
# Названия через запятую, регистр не важен. Пусто = все чаты аккаунта.
CHATS_ONLY=
